#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#undef ZMK_POINTING_DEFAULT_SCRL_VAL

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

&mt {
    tapping-term-ms = <300>;
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    tapping-term-ms = <300>;
    quick-tap-ms = <300>;
    flavor = "balanced";
};

/* Keep Keymap Editor's standard two-parameter encoder UI while filtering
 * both directions through the shared two-input volume divider. */

&inc_dec_kp {
    bindings = <&encoder_key_divider_cw>, <&encoder_key_divider_ccw>;
};

&zip_temp_layer {
    require-prior-idle-ms = <300>;
    excluded-positions = <18 19 20 21 22 35 36>;
};

&mkp_input_listener { input-processors = <&zip_temp_layer 1 10000>; };

/ {
    combos {
        compatible = "zmk,combos";

        exit_app {
            bindings = <&kp LG(Q)>;
            key-positions = <8 9>;
        };

        log_off {
            bindings = <&kp LG(LC(Q))>;
            key-positions = <33 32>;
        };
    };

    behaviors {
        mouse_lt: mouse_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            quick-tap-ms = <300>;
            bindings = <&mo>, <&mkp>;

            display-name = "Mouse Layer-Tap";
        };

        encoder_key_divider_cw: encoder_key_divider_cw {
            compatible = "zmk,behavior-encoder-key-divider";
            #binding-cells = <1>;
            bindings = <&kp>;
            divisor = <2>;
            timeout-ms = <300>;
            direction = <1>;
            display-name = "Encoder Two-Step Clockwise";
        };

        encoder_key_divider_ccw: encoder_key_divider_ccw {
            compatible = "zmk,behavior-encoder-key-divider";
            #binding-cells = <1>;
            bindings = <&kp>;
            divisor = <2>;
            timeout-ms = <300>;
            direction = <2>;
            display-name = "Encoder Two-Step Counter-Clockwise";
        };

        scroll_up_down: mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        scroll_down_up: mouse_wheel_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };

        scroll_right_left: mouse_wheel_right_left {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            display-name = "Base";
            bindings = <
&kp Q             &kp W         &kp E             &kp R      &kp T                                             &kp Y                         &kp U  &lt 3 I      &kp O    &kp P
&kp A             &kp S         &kp D             &kp F      &kp G             &none            &kp DELETE     &kp H                         &kp J  &lt 2 K      &kp L    &kp MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C             &kp V      &kp B             &kp TAB          &kp BACKSPACE  &kp N                         &kp M  &lt 4 COMMA  &kp DOT  &mt RIGHT_SHIFT QUESTION
&kp ESCAPE        &kp LEFT_ALT  &kp LEFT_COMMAND  &kp LCTRL  &lt 5 LANGUAGE_2  &lt 6 SPACE      &lt 7 ENTER    &mt RIGHT_COMMAND LANGUAGE_1                               &kp SEMICOLON
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        layer_1 {
            display-name = "Mouse";
            bindings = <
&trans          &trans        &trans            &trans  &trans                      &trans  &trans    &trans           &trans    &trans
&trans          &trans        &trans            &trans  &trans  &none       &trans  &trans  &mkp MB1  &mouse_lt 2 MB3  &mkp MB2  &kp RIGHT_COMMAND
&kp LEFT_SHIFT  &trans        &trans            &trans  &trans  &trans      &trans  &trans  &trans    &trans           &trans    &trans
&trans          &kp LEFT_ALT  &kp LEFT_COMMAND  &trans  &trans  &trans      &trans  &trans                                       &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        layer_2 {
            display-name = "Scroll";
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &none       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_3 {
            display-name = "Gesture 1";
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans              &kp LC(UP_ARROW)    &trans               &trans
&trans  &trans  &trans  &trans  &trans  &none       &trans  &trans  &kp LC(LEFT_ARROW)  &trans              &kp LC(RIGHT_ARROW)  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans              &kp LC(DOWN_ARROW)  &trans               &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                               &trans
            >;
        };

        layer_4 {
            display-name = "Gesture 2";
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans           &kp LG(T)      &trans       &trans
&trans  &trans  &trans  &trans  &trans  &none       &trans  &trans  &kp LC(LS(TAB))  &trans         &kp LC(TAB)  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans           &kp LG(LS(N))  &trans       &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                               &trans
            >;
        };

        layer_5 {
            display-name = "symbol";
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN     &kp HASH        &kp DOLLAR     &kp PERCENT                        &kp CARET  &kp AMPERSAND  &kp ASTERISK   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp LG(LS(N3))   &kp LG(LS(N4))  &kp LG(LS(N5))  &kp LA(A)      &kp LG(LA(S))  &none       &trans  &kp MINUS  &kp EQUAL      &kp SLASH      &kp LEFT_BRACKET      &kp RIGHT_BRACKET
&trans           &trans          &kp LG(LA(C))   &kp LG(LA(V))  &trans         &trans      &trans  &trans     &kp TILDE      &kp SEMICOLON  &kp SQT               &kp GRAVE
&trans           &trans          &trans          &trans         &trans         &mo 8       &trans  &trans                                                         &trans
            >;

            sensor-bindings = <&scroll_right_left>;
        };

        layer_6 {
            display-name = "number";
            bindings = <
&kp F1   &kp F2   &kp F3  &kp F4  &kp F5                          &kp PERIOD    &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp PLUS
&kp F6   &kp F7   &kp F8  &kp F9  &kp F10  &none       &kp LA(Y)  &kp COMMA     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp MINUS
&kp F11  &kp F12  &trans  &trans  &trans   &trans      &kp EQUAL  &kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp ASTERISK
&trans   &trans   &trans  &trans  &trans   &trans      &trans     &kp COLON                                               &kp SLASH
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_7 {
            display-name = "move";
            bindings = <
&trans  &kp LG(N0)              &kp LG(MINUS)      &kp LG(PLUS)             &trans                      &kp LG(C)  &kp LG(LA(C))       &kp UP_ARROW    &kp LG(V)            &kp LG(W)
&trans  &kp K_MUTE              &kp C_VOLUME_DOWN  &kp C_VOLUME_UP          &trans  &none       &trans  &kp LC(A)  &kp LEFT_ARROW      &kp DOWN_ARROW  &kp RIGHT_ARROW      &kp LC(E)
&trans  &kp LA(LC(LEFT_ARROW))  &kp LA(LC(F))      &kp LA(LC(RIGHT_ARROW))  &trans  &trans      &trans  &kp HOME   &kp LG(LEFT_ARROW)  &kp LG(LA(P))   &kp LG(RIGHT_ARROW)  &kp END
&trans  &trans                  &trans             &trans                   &trans  &trans      &trans  &kp LG(R)                                                           &kp LG(LS(H))
            >;
        };

        layer_8 {
            display-name = "setting";
            bindings = <
&out OUT_BLE  &out OUT_USB  &none  &none  &none                                   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&none         &none         &none  &none  &none  &none            &studio_unlock  &none         &none         &none         &none         &none
&none         &none         &none  &none  &none  &bootloader      &bootloader     &none         &none         &none         &none         &bt BT_CLR
&none         &none         &none  &none  &none  &none            &none           &trans                                                  &bt BT_CLR_ALL
            >;
        };

        layer_9 {
            display-name = "User 9";
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &none       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };
    };
};
